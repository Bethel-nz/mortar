{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["agent.ts", "permissions.ts", "sandbox.ts", "export.ts", "verify.ts", "ui.ts", "tags.ts", "mention-menu.ts", "tools.ts"]
}
