# Copy to .env and fill in. Bun loads .env and .env.local automatically.

# Meta API key for Muse models (api.meta.ai)
META_API_KEY=

# Optional: model id (default muse-spark-1.3-contributor); `bun agent.ts <model>` also works
# MORTAR_MODEL=

# Optional: skip y/N approval prompts, for scripts
# AUTO_APPROVE=1

# Vercel Sandbox credentials. Recommended: `bunx vercel link && bunx vercel env pull`,
# which writes VERCEL_OIDC_TOKEN to .env.local (expires after ~12h; pull again).
# Outside Vercel, set all three of these instead:
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
